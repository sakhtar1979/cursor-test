# MintFlow Mobile App Environment Configuration
# Copy this file to .env and fill in your actual values

# ===================================
# ENVIRONMENT CONFIGURATION
# ===================================
NODE_ENV=development
ENVIRONMENT=development

# ===================================
# API CONFIGURATION
# ===================================
API_BASE_URL=http://localhost:8000/api/v1
WS_BASE_URL=ws://localhost:8000/ws

# Staging URLs (uncomment for staging builds)
# API_BASE_URL=https://staging-api.mintflow.com/api/v1
# WS_BASE_URL=wss://staging-api.mintflow.com/ws

# Production URLs (uncomment for production builds)
# API_BASE_URL=https://api.mintflow.com/api/v1
# WS_BASE_URL=wss://api.mintflow.com/ws

# ===================================
# APP CONFIGURATION
# ===================================
APP_NAME=MintFlow
APP_VERSION=1.0.0
BUILD_NUMBER=1

# Bundle IDs
IOS_BUNDLE_ID=com.mintflow.app
ANDROID_PACKAGE_NAME=com.mintflow.app

# ===================================
# EXTERNAL SERVICES
# ===================================

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn-here

# Amplitude (Analytics)
AMPLITUDE_API_KEY=your-amplitude-api-key

# Branch (Deep Linking)
BRANCH_IOS_KEY=your-branch-ios-key
BRANCH_ANDROID_KEY=your-branch-android-key

# Firebase (Push Notifications & Crashlytics)
FIREBASE_IOS_APP_ID=your-firebase-ios-app-id
FIREBASE_ANDROID_APP_ID=your-firebase-android-app-id

# ===================================
# PLAID CONFIGURATION
# ===================================
PLAID_ENV=sandbox
PLAID_CLIENT_NAME=MintFlow
PLAID_WEBHOOK_URL=http://localhost:8000/api/v1/webhooks/plaid

# ===================================
# SECURITY CONFIGURATION
# ===================================
JWT_SECRET=your-jwt-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here

# PIN & Biometric Settings
PIN_LENGTH=4
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# ===================================
# FEATURE FLAGS
# ===================================
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_OFFLINE_MODE=true
ENABLE_DEEP_LINKING=true
ENABLE_RECEIPT_SCANNING=true
ENABLE_INVESTMENT_TRACKING=false
ENABLE_BUSINESS_ACCOUNTS=false
ENABLE_CRYPTO_TRACKING=false

# ===================================
# DEVELOPMENT SETTINGS
# ===================================
ENABLE_REDUX_LOGGER=true
ENABLE_FLIPPER=true
MOCK_API=false
SHOW_DEV_MENU=true

# ===================================
# CACHE CONFIGURATION
# ===================================
CACHE_SHORT_DURATION=300000
CACHE_MEDIUM_DURATION=1800000
CACHE_LONG_DURATION=86400000

# ===================================
# UI CONFIGURATION
# ===================================
DEFAULT_CURRENCY=USD
DATE_FORMAT=MM/DD/YYYY
TIME_FORMAT=12h
PAGE_SIZE=20

# ===================================
# NOTIFICATION SETTINGS
# ===================================
ENABLE_BUDGET_ALERTS=true
ENABLE_TRANSACTION_ALERTS=true
ENABLE_BILL_REMINDERS=true
ENABLE_GOAL_UPDATES=true
ENABLE_SECURITY_ALERTS=true

# ===================================
# BANKING CONFIGURATION
# ===================================
TRANSACTION_SYNC_INTERVAL=1800000
ACCOUNT_SYNC_INTERVAL=3600000
BALANCE_SYNC_INTERVAL=900000

# ===================================
# APP STORE CONFIGURATION
# ===================================
IOS_APP_ID=123456789
REVIEW_PROMPT_DELAY=604800000
MIN_SESSIONS_FOR_REVIEW=10

# ===================================
# LIMITS & CONSTRAINTS
# ===================================
MAX_ACCOUNTS=50
MAX_BUDGETS=20
MAX_GOALS=10
MAX_FILE_SIZE=10485760
MAX_PHOTO_SIZE=5242880

# ===================================
# LEGAL & SUPPORT
# ===================================
TERMS_URL=https://mintflow.com/terms
PRIVACY_URL=https://mintflow.com/privacy
SUPPORT_EMAIL=support@mintflow.com
SUPPORT_PHONE=+1-800-MINTFLOW

# ===================================
# DEVELOPMENT OVERRIDES
# ===================================
# Uncomment to override specific settings for development

# Force specific environment
# FORCE_ENVIRONMENT=development

# Mock external services
# MOCK_PLAID=true
# MOCK_NOTIFICATIONS=true
# MOCK_BIOMETRICS=true

# Debug settings
# VERBOSE_LOGGING=true
# DISABLE_NETWORK_CACHE=true
# SHOW_NETWORK_REQUESTS=true